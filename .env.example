NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Supabase key used only for verified payment-webhook reconciliation.
# Prefer the modern sb_secret_ key. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Stripe-hosted Checkout. Keep both values server-only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional owner notifications. Never prefix secrets with NEXT_PUBLIC_.
RESEND_API_KEY=
SERVICE_NOTIFICATION_EMAIL=
